{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zoranlj/software-factory-antigravity/factory/schemas/job.schema.json",
  "title": "Software Factory Job State",
  "description": "Machine-readable state contract for a Software Factory job (Level 3 local and Level 4 headless).",
  "type": "object",
  "required": ["id", "feature", "branch", "stage", "round", "reviews"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9._-]+$",
      "description": "Unique job identifier (e.g. 001-reading-time)."
    },
    "feature": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "enum": ["local", "headless"],
      "default": "local",
      "description": "Execution mode: local interactive (Level 3) or headless CI pipeline (Level 4)."
    },
    "branch": {
      "type": "string",
      "pattern": "^factory/.+"
    },
    "worktree": {
      "type": "string"
    },
    "stage": {
      "type": "string",
      "enum": ["spec", "build", "review", "approve", "pr-open", "merged", "needs-human"]
    },
    "round": {
      "type": "integer",
      "minimum": 0
    },
    "issue_number": {
      "type": ["integer", "null"]
    },
    "pr_number": {
      "type": ["integer", "null"]
    },
    "pr_url": {
      "type": ["string", "null"]
    },
    "depends_on": {
      "type": "array",
      "items": { "type": "string" },
      "description": "List of issue references (e.g. #41, org/repo#12) that must be closed before dispatch."
    },
    "active_agents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "status": { "type": "string", "enum": ["running", "done", "failed"] }
        }
      }
    },
    "reviews": {
      "type": "object",
      "required": ["security", "ux", "ui", "code"],
      "properties": {
        "security": { "type": "string", "enum": ["pending", "PASS", "CHANGES"] },
        "ux": { "type": "string", "enum": ["pending", "PASS", "CHANGES"] },
        "ui": { "type": "string", "enum": ["pending", "PASS", "CHANGES"] },
        "code": { "type": "string", "enum": ["pending", "PASS", "CHANGES"] }
      }
    },
    "tokens": {
      "type": "object",
      "properties": {
        "prompt": { "type": "integer", "minimum": 0 },
        "completion": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 },
        "by_agent": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["prompt", "completion", "total"],
            "properties": {
              "prompt": { "type": "integer", "minimum": 0 },
              "completion": { "type": "integer", "minimum": 0 },
              "total": { "type": "integer", "minimum": 0 },
              "model": { "type": "string" }
            }
          }
        }
      }
    },
    "timestamps": {
      "type": "object",
      "properties": {
        "started_at": { "type": "string" },
        "pr_opened_at": { "type": ["string", "null"] },
        "merged_at": { "type": ["string", "null"] }
      }
    },
    "kpi": {
      "type": "object",
      "properties": {
        "tests_passed_first_try": { "type": "boolean" },
        "tests_passed_final": { "type": "boolean" },
        "pr_generated": { "type": "boolean" },
        "human_review_seconds": { "type": ["number", "null"] }
      }
    }
  }
}
