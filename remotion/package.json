{
  "name": "software-factory-remotion",
  "version": "1.0.0",
  "private": true,
  "description": "Remotion 60s showcase animation for Software Factory for Google Antigravity",
  "scripts": {
    "dev": "remotion studio",
    "studio": "remotion studio",
    "render": "remotion render src/index.ts SoftwareFactoryShowcase ../factory/demo_assets/SoftwareFactoryRemotion.mp4",
    "render:3d": "remotion render src/index.ts SoftwareFactory3D ../factory/demo_assets/SoftwareFactory3D.mp4",
    "render:kinetic": "remotion render src/index.ts SoftwareFactoryKinetic ../factory/demo_assets/SoftwareFactoryKinetic.mp4",
    "render:trailer": "node scripts/generate-trailer-audio.mjs && remotion render src/index.ts SoftwareFactoryTrailer ../factory/demo_assets/SoftwareFactoryTrailer.mp4",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.282",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.282"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "typescript": "5.7.2"
  }
}

